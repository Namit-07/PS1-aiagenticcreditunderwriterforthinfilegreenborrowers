# ---- AI Service configuration (copy to .env) ----

# Application
APP_NAME=AI Credit Underwriter - AI Service
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8100

# ---- LLM (optional; Gemini free tier recommended) ----
# Get a free key at https://aistudio.google.com/apikey and paste it here.
# As soon as a key is present, MOCK_AI_MODE defaults to false and Gemini writes the
# credit-memo narrative (executive summary + plain-language borrower explanation) and
# risk reasoning. It NEVER computes financial numbers (EMI / FOIR / LTV stay deterministic).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=25

# OpenAI-compatible fallback (used only when no Gemini key is set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Force zero-cost mode even if a key is present (true) or force LLM usage (false).
# Leave unset to auto-detect from the keys above.
# MOCK_AI_MODE=true

# Policy profile to load at startup: default | conservative | aggressive
POLICY_PROFILE=default
POLICY_PATH=./policies

# Persistence (SQLite file by default; Postgres URL in production)
# DATABASE_URL=sqlite:///./data/ai_service.db
