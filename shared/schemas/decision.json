{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/decision.json",
  "title": "UnderwritingDecision",
  "description": "The final underwriting decision produced by the AI service policy evaluation, with reasons, confidence and traceability.",
  "type": "object",
  "required": ["run_id", "status", "decision", "confidence", "reasons", "financials", "created_at"],
  "properties": {
    "run_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["running", "awaiting_human", "completed", "failed"] },
    "decision": {
      "type": "string",
      "enum": ["approved", "declined", "referred", "human_review"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity"],
        "properties": {
          "code": { "type": "string", "description": "Reference a code in shared/reason_codes.yaml" },
          "severity": { "type": "string", "enum": ["info", "warning", "blocker"] },
          "message": { "type": "string" },
          "field": { "type": ["string", "null"] }
        }
      }
    },
    "financials": { "$ref": "financials.json" },
    "evidence_summary": { "type": "array" },
    "human_review_required": { "type": "boolean", "default": false },
    "approved_amount_limit": { "type": ["number", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}