{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/evidence.json",
  "title": "EvidenceItem",
  "description": "A single piece of extracted evidence produced by the AI service, tied to a source document. Shared contract between Team A and Team B.",
  "type": "object",
  "required": ["id", "source_document_id", "category", "field_name", "value", "confidence", "page_ref"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "source_document_id": { "type": "string", "description": "Id of the source document/store object the evidence came from" },
    "category": {
      "type": "string",
      "enum": ["identity", "income", "liabilities", "asset", "platform_earnings", "invoice", "bank", "other"]
    },
    "field_name": { "type": "string", "description": "Semantic field, e.g. monthly_income" },
    "value": { "type": ["string", "number", "boolean", "null"] },
    "unit": { "type": "string", "default": null },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "page_ref": { "type": ["integer", "null"], "description": "Page number in source pdf, if known" },
    "reconciled": { "type": "boolean", "default": false },
    "citations": {
      "type": "array",
      "items": { "$ref": "#/definitions/citation" }
    }
  },
  "definitions": {
    "citation": {
      "type": "object",
      "required": ["document_id", "text_snippet"],
      "properties": {
        "document_id": { "type": "string" },
        "text_snippet": { "type": "string" },
        "page": { "type": ["integer", "null"] }
      }
    }
  },
  "additionalProperties": true
}