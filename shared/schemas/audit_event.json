{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/audit_event.json",
  "title": "AuditEvent",
  "description": "An immutable audit-trace event recorded during an underwriting run. Enables proof, replay and regulatory review.",
  "type": "object",
  "required": ["event_id", "run_id", "sequence", "step", "actor", "timestamp", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 0 },
    "step": {
      "type": "string",
      "enum": ["request_received", "documents_extracted", "evidence_reconciled", "financials_computed", "policy_evaluated", "decision_made", "human_review", "what_if"]
    },
    "actor": { "type": "string", "enum": ["system", "ai_service", "backend", "user"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "trace_id": { "type": ["string", "null"], "description": "Correlates with AI service /underwrite/{run_id}/trace" }
  },
  "additionalProperties": true
}