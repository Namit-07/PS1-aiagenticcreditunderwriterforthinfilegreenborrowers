{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/financials.json",
  "title": "FinancialComputation",
  "description": "Deterministic financial computation outputs (EMI, FOIR, LTV, income). Produced by financial logic, NEVER by the LLM directly.",
  "type": "object",
  "required": ["monthly_income", "total_monthly_obligations", "monthly_emi", "foir", "ltv"],
  "properties": {
    "monthly_income": { "type": "number", "minimum": 0 },
    "total_monthly_obligations": { "type": "number", "minimum": 0 },
    "monthly_emi": { "type": "number", "minimum": 0 },
    "foir": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fixed Obligation to Income Ratio" },
    "ltv": { "type": "number", "minimum": 0, "maximum": 1, "description": "Loan to Value ratio" },
    "effective_rate_nominal": { "type": ["number", "null"] },
    "incidental": {
      "type": "object",
      "properties": {
        "income_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "discretionary_income": { "type": "number", "minimum": 0 }
      }
    }
  },
  "additionalProperties": true
}