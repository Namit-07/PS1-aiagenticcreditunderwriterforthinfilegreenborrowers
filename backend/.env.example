# ---- Backend configuration (copy to .env) ----

# Application
APP_NAME=AI Credit Underwriter - Backend
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Local zero-config demo: SQLite (default when unset) -> backend/data/backend.db
# Production (Supabase / Postgres):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_credit_underwriter
# DATABASE_URL=sqlite:///./data/backend.db

# AI Service (Team B) - REST endpoint
AI_SERVICE_URL=http://localhost:8100
AI_SERVICE_TIMEOUT=90

# true -> canned AI responses (frontend/backend dev without Team B). Default false = real AI service.
MOCK_AI_MODE=false

# Auth: demo login accepts any non-empty email/password unless DEMO_USER_* are set
DEMO_AUTH=true
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
# Supabase Auth (optional; access tokens are verified with the JWT secret)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Storage: local folder by default (uploads are validated: pdf/png/jpg/jpeg/txt, <= MAX_UPLOAD_MB)
STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,txt
STORAGE_BUCKET=documents

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000
